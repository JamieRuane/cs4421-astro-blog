	@media (max-width: 600px) {
		.weather-card {
			padding: 1rem;
		}

		.weather-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.temperature-badge {
			min-width: unset;
			padding: 0.5rem 0.8rem;
