<div class="weather-card" data-weather-card>
	<div class="weather-header">
		<div>
			<p class="weather-label">LOCAL WEATHER</p>
			<h3>Askeaton, Co. Limerick</h3>
		</div>
		<div class="temperature-badge" data-temperature>--°C</div>
	</div>

	<div class="weather-body">
		<p class="weather-condition" data-condition>Checking the forecast…</p>
		<div class="weather-grid">
			<div class="weather-stat">
				<span>Feels like</span>
				<strong data-feels-like>--°C</strong>
			</div>
			<div class="weather-stat">
				<span>Wind</span>
				<strong data-wind>-- km/h</strong>
			</div>
			<div class="weather-stat">
				<span>Humidity</span>
				<strong data-humidity>--%</strong>
			</div>
			<div class="weather-stat">
				<span>Rain</span>
				<strong data-rain>-- mm</strong>
			</div>
		</div>
	</div>
</div>

<script>
	type WeatherResponse = {
		current?: {
			temperature_2m?: number;
			relative_humidity_2m?: number;
			apparent_temperature?: number;
			precipitation?: number;
			weather_code?: number;
			wind_speed_10m?: number;
		};
	};

	const weatherDescriptions: Record<number, string> = {
		0: 'Clear sky',
		1: 'Mainly clear',
		2: 'Partly cloudy',
		3: 'Overcast',
		45: 'Foggy',
		48: 'Depositing rime fog',
		51: 'Light drizzle',
		53: 'Moderate drizzle',
		55: 'Dense drizzle',
		56: 'Freezing drizzle',
		57: 'Heavy freezing drizzle',
		61: 'Slight rain',
		63: 'Moderate rain',
		65: 'Heavy rain',
		66: 'Light freezing rain',
		67: 'Heavy freezing rain',
		71: 'Light snow',
		73: 'Moderate snow',
		75: 'Heavy snow',
		77: 'Snow grains',
		80: 'Rain showers',
		81: 'Heavy showers',
		82: 'Violent showers',
		85: 'Light snow showers',
		86: 'Heavy snow showers',
		95: 'Thunderstorm',
		96: 'Thunderstorm with hail',
		99: 'Severe thunderstorm',
	};

	const card = document.querySelector<HTMLElement>('[data-weather-card]');
	if (!card) {
		throw new Error('Weather component not found');
	}

	const temperatureNode = card.querySelector<HTMLElement>('[data-temperature]');
	const conditionNode = card.querySelector<HTMLElement>('[data-condition]');
	const feelsLikeNode = card.querySelector<HTMLElement>('[data-feels-like]');
	const windNode = card.querySelector<HTMLElement>('[data-wind]');
	const humidityNode = card.querySelector<HTMLElement>('[data-humidity]');
	const rainNode = card.querySelector<HTMLElement>('[data-rain]');

	const formatNumber = (value: number | undefined, digits = 0) =>
		typeof value === 'number' && Number.isFinite(value) ? value.toFixed(digits) : '--';

	async function loadWeather() {
		try {
			const response = await fetch('/api/weather');
			if (!response.ok) {
				throw new Error(`Weather service returned ${response.status}`);
			}

			const data: WeatherResponse = await response.json();
			const current = data.current;

			if (temperatureNode) {
				temperatureNode.textContent = `${formatNumber(current?.temperature_2m)}°C`;
			}
			if (conditionNode) {
				conditionNode.textContent = weatherDescriptions[current?.weather_code ?? -1] ?? 'Weather unavailable';
			}
			if (feelsLikeNode) {
				feelsLikeNode.textContent = `${formatNumber(current?.apparent_temperature)}°C`;
			}
			if (windNode) {
				windNode.textContent = `${formatNumber(current?.wind_speed_10m)} km/h`;
			}
			if (humidityNode) {
				humidityNode.textContent = `${formatNumber(current?.relative_humidity_2m)}%`;
			}
			if (rainNode) {
				rainNode.textContent = `${formatNumber(current?.precipitation, 1)} mm`;
			}
		} catch (error) {
			console.error('Unable to fetch weather data', error);
			if (conditionNode) {
				conditionNode.textContent = 'Weather data unavailable';
			}
			if (temperatureNode) {
				temperatureNode.textContent = '–';
			}
			if (feelsLikeNode) {
				feelsLikeNode.textContent = '–';
			}
			if (windNode) {
				windNode.textContent = '–';
			}
			if (humidityNode) {
				humidityNode.textContent = '–';
			}
			if (rainNode) {
				rainNode.textContent = '–';
			}
		}
	}

	loadWeather();
</script>

<style>
	.weather-card {
		margin-top: 2rem;
		padding: 1.5rem;
		border: 1px solid rgba(var(--gray), 25%);
		border-radius: 18px;
		background: rgba(var(--gray-light), 0.45);
		box-shadow: var(--box-shadow);
	}

	.weather-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.weather-label {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		opacity: 0.7;
	}

	.weather-card h3 {
		margin: 0;
		font-size: clamp(1.5rem, 3vw, 2.2rem);
	}

	.temperature-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 88px;
		padding: 0.7rem 0.9rem;
		font-size: 1.8rem;
		font-weight: 700;
		border-radius: 999px;
		background: rgba(var(--accent), 0.1);
		color: var(--accent);
	}

	.weather-body {
		display: grid;
		gap: 1rem;
	}

	.weather-condition {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 600;
	}

	.weather-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.weather-stat {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.85rem 1rem;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.35);
		border: 1px solid rgba(var(--gray), 18%);
	}

	.weather-stat span {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.72;
	}

	.weather-stat strong {
		font-size: 1.1rem;
		color: rgb(var(--black));
	}

	@media (max-width: 600px) {
		.weather-card {
			padding: 1rem;
		}

		.weather-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.temperature-badge {
			min-width: unset;
			padding: 0.5rem 0.8rem;
			font-size: 1.5rem;
		}
	}
</style>
