---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import DinoGame from '../components/DinoGame.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="welcome">
				<p class="eyebrow">HELLO 👋</p>

				<h1>WELCOME TO MY BLOG!</h1>

				<p class="intro">
					Hi, I'm Jamie — a software engineering student from Ireland
					who enjoys technology, music, travel and learning new things.
				</p>
			</section>

			<section class="game-section">
				<p class="eyebrow">TAKE A BREAK</p>

				<h2>TRY OUT A QUICK GAME</h2>

				<p>
					Help the little dinosaur jump over the obstacles!
				</p>
<DinoGame />
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 900px;
		margin: 0 auto;
		padding: 80px 20px;
	}

	.welcome {
		margin-bottom: 100px;
	}

	.eyebrow {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		opacity: 0.6;
		margin-bottom: 20px;
	}

	h1 {
		font-size: clamp(3rem, 8vw, 6rem);
		line-height: 1;
		margin-bottom: 30px;
	}

	.intro {
		max-width: 650px;
		font-size: 1.2rem;
		line-height: 1.7;
		opacity: 0.8;
	}

	.game-section {
		border-top: 1px solid currentColor;
		padding-top: 40px;
	}

	h2 {
		font-size: 2rem;
		margin-bottom: 10px;
	}

	.game-placeholder {
		margin-top: 30px;
		min-height: 250px;
		border: 1px solid currentColor;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0.7;
	}

	.game-placeholder p {
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	@media (max-width: 600px) {
		main {
			padding: 60px 20px;
		}

		h1 {
			font-size: 3rem;
		}

		.intro {
			font-size: 1.05rem;
		}
	}
</style>