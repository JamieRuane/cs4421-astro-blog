{
  "name": "my-astro-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "movies:validate": "node scripts/validate-movies-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "test:unit": "vitest run",
    "security:validate": "node scripts/validate-security-policy.mjs",
    "security:refresh-hashes": "node scripts/validate-security-policy.mjs --refresh-hashes",
    "lint": "eslint \"{src,backend,cdk,test}/**/*.{js,ts}\""
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/node": "^11.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@aws-sdk/client-cloudwatch": "^3.1155.0",
    "@aws-sdk/client-secrets-manager": "^3.1153.0",
    "astro": "^7.4.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "aws-cdk": "^2.1144.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
